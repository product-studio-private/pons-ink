# RPC endpoints referenced by foundry.toml [rpc_endpoints]
INK_RPC_URL=https://rpc-gel.inkonchain.com
INK_SEPOLIA_RPC_URL=https://rpc-gel-sepolia.inkonchain.com

# Blockscout verification (any non-empty string works for Blockscout)
INK_EXPLORER_API_KEY=blockscout

# DeployInk.s.sol (all optional; defaults to the broadcasting account / Robinhood economics)
FINAL_OWNER=
PROTOCOL_FEE_RECIPIENT=
FEE_SWEEP_OPERATOR=
LAUNCH_FORWARDER=
LAUNCH_FEE=500000000000000
LAUNCH_ENABLED=true
WRITE_DEPLOYMENT=true
